# cocarr-workspace-api — environment variables
NODE_ENV=production
PORT=3040

# --- Workspace database (MySQL) ----------------------------------------------
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=cocarr_workspace
DB_USER=cocarr
DB_PASS=change-me

# --- CORS (comma-separated browser origins; unset = allow all + warn) --------
CORS_ORIGINS=https://workspace.cocarr.com

# --- Firebase (ADMIN/staff project — same project as core-api) ---------------
# JSON string (one line) or a path to the service-account file. When unset,
# staff-login creation is disabled and onboarding approval still activates the
# employee but records firebaseLinked=false (dev-friendly).
ADMIN_SERVICE_ACCOUNT=

# --- Dev-only auth escape hatch (NEVER true in production) --------------------
# Dev-only bypass. Requires NODE_ENV!=production — a stray 'true' promoted to a
# production environment is ignored and logged, never honoured.
AUTH_DISABLED=false

# NOTE: an unconfigured ADMIN_SERVICE_ACCOUNT is NOT a dev mode. Without either
# ADMIN_SERVICE_ACCOUNT or GATEWAY_KEY, every authenticated route answers 503.

# --- Trusted edge <-> gateway contract ---------------------------------------
# Shared secret proving a request reached this service THROUGH cocarr-api-gateway.
# Must be the SAME value as GATEWAY_KEY on the gateway. When set, requests
# carrying a matching x-gateway-key are trusted for identity (x-user-id /
# x-identity-id) and skip a second Firebase verification. A NON-matching key is
# a hard deny, never a fall-through. Unset = the header is ignored entirely and
# every caller must present a bearer token.
# Generate with:  openssl rand -hex 32
GATEWAY_KEY=

# --- Platform IAM (cocarr-authorization-service) ------------------------------
# Where to ask "may this principal do X?". Every /v1 route is gated on a
# permission key (workspace.<module>.<action>) resolved there — this service
# keeps no permission rules of its own.
AUTHORIZATION_SERVICE_URL=http://localhost:3060

# Enforcement is ON unless this is exactly 'false', which falls back to dry-run
# (denials logged, requests allowed) so a lockout can be debugged without a
# redeploy. Same meaning as RBAC_ENFORCE in cocarr-core-api.
RBAC_ENFORCE=true

# How long a resolved permission set is cached, in ms. The cost of caching is
# that a REVOCATION takes up to this long to bite; 0 disables it and makes every
# gated request a round-trip to IAM.
PERMISSION_CACHE_MS=15000
AUTHORIZATION_TIMEOUT_MS=3000
